NODE_ENV=production
HOST=0.0.0.0
PORT=3000
APP_BASE_URL=https://nebula.example.com
TRUST_PROXY=true
COOKIE_SECURE=true
COOKIE_SECRET=replace-with-at-least-32-random-characters

DATABASE_URL=mysql://nebula:replace-me@mariadb.example.com:3306/nebula

RUSTFS_ENDPOINT=https://rustfs-api.example.com
RUSTFS_REGION=us-east-1
RUSTFS_BUCKET=nebula
RUSTFS_ACCESS_KEY_ID=replace-me
RUSTFS_SECRET_ACCESS_KEY=replace-me
RUSTFS_PUBLIC_BASE_URL=https://cdn.example.com/nebula

CURSEFORGE_API_KEY=replace-me
JAVA_EXECUTABLE=/usr/bin/java
MAX_UPLOAD_BYTES=2147483648
WORKER_ENABLED=true
WORKER_POLL_MS=2000
NEBULA_HTTP_PORT=3000

# One-time bootstrap command only. Prefer Docker secrets in production.
NEBULA_ADMIN_USERNAME=admin
# NEBULA_ADMIN_PASSWORD=replace-with-a-temporary-password
# NEBULA_ADMIN_PASSWORD_FILE=/run/secrets/nebula_admin_password
