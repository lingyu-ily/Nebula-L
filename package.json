{
  "name": "nebula",
  "version": "0.1.0",
  "description": "Utility package to generate a distribution.json for Helios.",
  "private": true,
  "type": "module",
  "exports": "./dist/index.js",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "@isaacs/brace-expansion": "5.0.1"
  },
  "scripts": {
    "clean": "rimraf dist apps/server/dist apps/web/dist packages/shared/dist",
    "tsc": "tsc -p tsconfig.json",
    "build:generator": "npm run tsc",
    "build:shared": "npm run build -w @nebula/shared",
    "build:lint-deps": "npm run build:generator && npm run build:shared",
    "build": "npm run clean && npm run build:generator && npm run build -w @nebula/shared && npm run build -w @nebula/server && npm run build -w @nebula/web",
    "start": "npm run build:generator && node dist/index.js",
    "start:web": "node apps/server/dist/index.js",
    "dev:server": "npm run dev -w @nebula/server",
    "dev:web": "npm run dev -w @nebula/web",
    "cli": "npm run build:generator && node dist/index.js",
    "fs": "node dist/index.js",
    "faststart": "node dist/index.js",
    "prelint": "npm run build:lint-deps",
    "lint": "eslint .",
    "pretest": "npm run build:lint-deps",
    "test": "npm run test --workspaces --if-present",
    "test:unit": "npm test",
    "test:e2e": "npm run test:e2e -w @nebula/web",
    "db:migrate": "npm run db:migrate -w @nebula/server",
    "admin:create": "npm run admin:create -w @nebula/server"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dscalzi/Nebula.git"
  },
  "keywords": [
    "helios",
    "nebula",
    "distribution"
  ],
  "author": "Daniel Scalzi",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/dscalzi/Nebula/issues"
  },
  "homepage": "https://github.com/dscalzi/Nebula#readme",
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.6.1",
    "@types/fs-extra": "^11.0.4",
    "@types/luxon": "^3.7.1",
    "@types/node": "^22.20.1",
    "@types/triple-beam": "^1.3.5",
    "@types/yargs": "^17.0.35",
    "eslint": "^9.39.2",
    "rimraf": "^6.1.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.51.0"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "fs-extra": "^11.3.3",
    "got": "^14.6.5",
    "helios-distribution-types": "^1.3.0",
    "luxon": "^3.7.2",
    "minimatch": "10.2.6",
    "node-stream-zip": "^1.15.0",
    "toml": "^3.0.0",
    "triple-beam": "^1.4.1",
    "ts-json-schema-generator": "^2.4.0",
    "winston": "^3.19.0",
    "yargs": "^18.0.0"
  }
}
